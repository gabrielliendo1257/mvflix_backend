# Copia este archivo a envs/.env y llena los valores privados.
# envs/.env NO se commitea (gitignore); contiene credenciales y configuracion local.
# Los application-dev.yml leen estas variables con ${VAR:default}.

# ======================================================================
# Infraestructura Docker de desarrollo
# Makefile y docker-compose-dev.yml cargan estas variables desde este archivo.
# Las rutas *_DATA_SOURCE deben existir en el host Docker antes de arrancar.
# ======================================================================
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
MINIO_CORS_ALLOW_ORIGIN=http://192.168.1.101:4200,http://127.0.0.1:4200,http://192.168.1.101:9090,http://127.0.0.1:9090
MINIO_DATA_SOURCE=/media/backdev/windows/Users/user/Downloads/linux/mvflix/minio-data
# Endpoint que recibe eventos de uploads desde MinIO hacia Storage.
MINIO_WEBHOOK_ENDPOINT=http://192.168.1.102:6060/internal/minio/events

POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=mvflix_app

KAFKA_ADVERTISED_HOST=192.168.1.102
KAFKA_BOOTSTRAP_SERVERS=192.168.1.102:9094
KAFKA_EXTERNAL_PORT=9094
KAFKA_DATA_SOURCE=/media/backdev/windows/Users/user/Downloads/linux/mvflix/kafka-data
KAFKA_KRAFT_CLUSTER_ID=abcdefghijklmnopqrstuv
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_RETENTION_BYTES=1073741824
KAFKA_LOG_SEGMENT_BYTES=536870912
KAFKA_LOG_RETENTION_CHECK_INTERVAL_MS=300000

# Kafka para las aplicaciones Java arrancadas por scripts/stack-dev.sh.
# Debe coincidir con el host/puerto externo anunciado por el broker.
KAFKA_HOST=192.168.1.102
# Identidades estables de los consumidores; no compartirlas entre servicios.
MOVIES_KAFKA_GROUP=mvflix-movies
STORAGE_KAFKA_GROUP=mvflix-storage

# Observabilidad Docker.
OTEL_BIND_ADDRESS=0.0.0.0
OTEL_HTTP_PORT=4318
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9095
GRAFANA_BIND_ADDRESS=0.0.0.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
ACTUATOR_METRICS_USER=metrics
ACTUATOR_METRICS_PASSWORD=change-me

# TMDB: token de lectura (v3/v4) para el enriquecimiento del catalogo.
TMDB_API_TOKEN=

# Credenciales de servicios si no quieres los defaults de dev:
#MINIO_ACCESS_KEY=admin
#MINIO_SECRET_KEY=admin123
#MINIO_WEBHOOK_TOKEN=dev-webhook-secret

# Spring Boot Actuator / management server.
# Estas variables son por proceso. No descomentes un unico MANAGEMENT_SERVER_PORT
# si ejecutas varios servicios Java con este mismo archivo.
# Para Authorization ejecutado individualmente:
#MANAGEMENT_SERVER_ADDRESS=0.0.0.0
#MANAGEMENT_SERVER_PORT=10090
# Para Storage ejecutado individualmente, usa MANAGEMENT_SERVER_PORT=10060.
# Los demas servicios tienen sus puertos por defecto documentados en
# docs/observability.md.

# Secretos de clientes OAuth2 (defaults de dev):
#OAUTH2_CLIENT_SECRET=super-secret
# Machine-client movies-catalog (Movies → Storage, limpieza de objetos MANAGED).
#MOVIES_CATALOG_SECRET=super-secret

# ======================================================================
# LAN: probar el stack desde otro equipo/telefono (192.168.x.x).
# Descomenta este bloque y cambia <IP-LAN> por la IP de la maquina donde
# corre el stack. Sin estas vars, todo apunta a 127.0.0.1 (localhost).
# ======================================================================
#AUTHORIZATION_ISSUER_URL=http://<IP-LAN>:9090    # BFF: redirige el login al auth por LAN + auth: issuer fijo de los JWT
#AUTHORIZATION_URL=http://<IP-LAN>:9090           # BFF: endpoints del authorization-code flow
#BFF_ADDRESS=http://<IP-LAN>:9091                 # auth: redirect-uri registrado del cliente OAuth2
#FRONTEND_URL=http://<IP-LAN>:4200                # BFF: CORS + post-login redirect
#FRONTEND_ADDRESS=http://<IP-LAN>:4200            # auth: redirect de logout
#BFF_CORS_ALLOWED_ORIGINS=http://<IP-LAN>:4200    # BFF: origen CORS extra (ademas de FRONTEND_URL)
#BFF_SESSION_COOKIE_NAME=SESSION                  # LAN por HTTP: __Host- exige Secure
#BFF_SESSION_COOKIE_SECURE=false                  # Secure solo se acepta en localhost
#SECURITY_OAUTH2_ISSUER_URI=http://<IP-LAN>:9090  # users: valida el issuer del JWT (los tokens en LAN llevan iss LAN)
#MINIO_URL=http://<IP-LAN>:9000

# PostgreSQL: si corre en otra máquina, cambiar DB_HOST.
# Las credenciales (rw y migrator) se comparten entre servicios.
#DB_HOST=<IP-LAN>
#DB_PORT=5432
#DB_RW_USER=db_rw
#DB_RW_PASSWORD=12345678
#DB_MIGRATOR_USER=db_migrator
#DB_MIGRATOR_PASSWORD=12345678
