global:
  scrape_interval: 15s

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: mvflix-bff
    metrics_path: /actuator/prometheus
    basic_auth:
      username: ${ACTUATOR_METRICS_USER}
      password: ${ACTUATOR_METRICS_PASSWORD}
    static_configs:
      - targets: [host.docker.internal:10091]

  - job_name: mvflix-movies
    metrics_path: /actuator/prometheus
    basic_auth:
      username: ${ACTUATOR_METRICS_USER}
      password: ${ACTUATOR_METRICS_PASSWORD}
    static_configs:
      - targets: [host.docker.internal:10040]

  - job_name: mvflix-storage
