# Copia este archivo a .env y ajusta los valores por entorno.
# docker compose --env-file infra/docker/container-versions.env \
#   --env-file infra/docker/.env -f infra/docker/docker-compose-dev.yml carga
# las versiones comunes y los secretos respectivamente.
# NUNCA commitees .env con valores reales.

# MinIO (dev)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me
MINIO_CORS_ALLOW_ORIGIN=http://localhost:4200,http://localhost:9090
# Dejar vacío para usar el volumen Docker minio_data.
# MINIO_DATA_SOURCE=/mnt/mvflix-storage/minio-data
#MINIO_WEBHOOK_ENDPOINT=http://<IP-LAN-STORAGE-SERVICE>:6060/internal/minio/events # storage: endpoint de enventos minio

# Postgres superusuario (solo bootstrap; las apps usan db_rw/db_migrator via 00-roles.sql)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mvflix_app

# Kafka KRaft single-node (dev)
# Identificador estable del cluster local.
KAFKA_KRAFT_CLUSTER_ID=abcdefghijklmnopqrstuv
# Dejar vacío para usar el volumen Docker kafka_data. En un host con poco
# espacio, usar una ruta de un disco con capacidad suficiente.
# KAFKA_DATA_SOURCE=/mnt/mvflix-infra/kafka-data
# Host/IP que Kafka anuncia a clientes externos (Termux, teléfonos, etc.).
KAFKA_ADVERTISED_HOST=192.168.1.102
# Los servicios Java que corren fuera de Docker usan esta dirección.
KAFKA_BOOTSTRAP_SERVERS=192.168.1.102:9094
# Puerto externo publicado en todas las interfaces del host.
KAFKA_EXTERNAL_PORT=9094
# Retención máxima por defecto: 7 días o 1 GiB, lo que ocurra primero.
KAFKA_LOG_RETENTION_HOURS=168
KAFKA_LOG_RETENTION_MS=604800000
KAFKA_LOG_RETENTION_BYTES=1073741824
KAFKA_LOG_SEGMENT_BYTES=536870912
KAFKA_LOG_RETENTION_CHECK_INTERVAL_MS=300000
# Topic de borrado gestionado: lo crea kafka-init al arrancar el stack.

# Observabilidad
# Collector OTLP HTTP: usar la IP LAN de esta laptop desde Termux.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://<IP-LAN-DE-LA-LAPTOP>:4318/v1/traces
OTEL_BIND_ADDRESS=0.0.0.0
OTEL_HTTP_PORT=4318
PROMETHEUS_BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9095
GRAFANA_BIND_ADDRESS=0.0.0.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Credenciales del puerto management de las apps.
ACTUATOR_METRICS_USER=metrics
ACTUATOR_METRICS_PASSWORD=change-me
